  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "De repente, um macaco-prego saltou \xE0 frente deles com um grande sorriso.\r\n\r\n\u2014
    Eu sou Paco, o macaco-prego da Floresta Heterna! \u2014 disse ele. \u2014 Voc\xEAs
    entraram em um reino m\xE1gico! Para voltarem para casa, precisar\xE3o superar
    quatro desafios e conseguir quatro chaves.\r\n\r\nPaco explicou que cada desafio
    representa um importante conhecimento:\r\n\r\n #N\xFAmeros Romanos  \r\n #Multiplica\xE7\xE3o
    e Divis\xE3o  \r\n #MMC e MDC  \r\n #\xC1rea e Per\xEDmetro\r\n\r\nCom coragem,
    curiosidade e muita dedica\xE7\xE3o, voc\xEAs enfrentam cada n\xEDvel, aprendem
    com os desafios e conquistam as quatro chaves.\r\r\nAo final, retornam \xE0 grande
    porta de pedra pr\xF3xima \xE0 nascente da fonte Heterna. Ao encaixarem as chaves
    nos cadeados, a porta brilha intensamente e o caminho de volta se abre.\r\r\nVoc\xEAs
    atravessam a porta e voltam para casa, levando com voc\xEAs algo muito mais valioso
    do que as chaves: o conhecimento e a certeza de que aprender pode ser uma grande
    aventura!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
