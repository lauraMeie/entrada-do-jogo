  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Paco abriu um antigo pergaminho e explicou:\nNa Floresta Heterna, os n\xFAmeros
    tamb\xE9m podem ser escritos de um jeito diferente: usando s\xEDmbolos romanos!
    Eles s\xE3o representados por letras do alfabeto.\n\nConhe\xE7a os principais
    s\xEDmbolos:\nI = 1\nV = 5\nX = 10\nL = 50\nC = 100\nD = 500\nM = 1.000"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
  m_sharedMaterial: {fileID: 2164040, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
